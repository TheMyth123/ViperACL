# ==============================================================================
# ViperACL Git Ignore Policy
# ==============================================================================

# Environments & Local Secrets
.env
.env.*
config.yaml
venv/
.venv/
env/

# Development & Test Environment
dev/

# Session Data Storage & Dynamic Artifacts
data/logs/*
!data/logs/.gitkeep

data/projects/*
!data/projects/.gitkeep

data/settings.json
data/settings.json.tmp
data/extracted_hashes.txt
data/*.kirbi
data/*.zip
/projects/

# Preserve Essential Tools, Datasets & Models in data/ and models/
!data/tools/
!data/tools/**
!data/synthetic_training.csv
!data/synthetic_desc.csv
!data/rf_*
!data/lgbm_*
!data/transformer_*
!models/
!models/**

# Python Bytecode, Caching & Testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.so

# Packaging & Distribution
build/
dist/
*.egg-info/

# IDEs, Agents, & Scratch Files
.vscode/
.idea/
.roo/
.gemini/
.agents/
scratch/
AGENTS.md
AGENTS.MD
agents.md

# OS & Generic Archives
.DS_Store
Thumbs.db
*.zip
*.tar.gz
*.rar
*.7z
*.bak
*.swp
*~